flare_traffic_light: flare.traffic.green
{
	setup: lumen_hue_saturation
	ambient_color: (0, 120, 50)
	diffuse_color: (25, 120, 100)
	specular_color: (25, 120, 100)

	type: spot

	range: 30.0
	cut_range: 10.0
	inner_angle: 2.0
	outer_angle: 110.0
	forward_distance: false

	dir_type: angle
	flare_inner_angle: 40.0
	flare_outer_angle: 110.0

	pitch_offset: -65

	fade_distance: 200
	fade_span: 100

	lamp_color_slot: green
	semaphore_states[]: green
	model: "/model/flare/tr_green.pmd"
	scale_factor: 2
}

